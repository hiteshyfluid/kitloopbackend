  @@index([adminId], map: "idx_audit_log_admin_id")
  @@index([actionType], map: "idx_audit_log_action_type")
  @@index([targetType], map: "idx_audit_log_target_type")
  @@index([targetId], map: "idx_audit_log_target_id")
  @@index([createdAt(sort: Desc)], map: "idx_audit_log_created_at")
