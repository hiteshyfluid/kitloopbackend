model FeeConfig {
  id                       String        @id @default(uuid()) @db.Uuid
  configKey                String        @unique @map("config_key") @db.VarChar(100)
  configValue              Decimal       @map("config_value") @db.Decimal(10, 4)
  configType               FeeConfigType @map("config_type")
  description              String
  sportId                  String?       @map("sport_id") @db.Uuid
  isPromotional            Boolean       @default(false) @map("is_promotional")
  promotionalStart         DateTime?     @map("promotional_start")
  promotionalEnd           DateTime?     @map("promotional_end")
  previousValue            Decimal?      @map("previous_value") @db.Decimal(10, 4)
  updatedBy                String?       @map("updated_by") @db.Uuid
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")

