  @@index([promotionalEnd], map: "idx_fee_config_promo_end")
  @@map("fee_config")
}

model SiteSetting {
  id           String    @id @default(uuid()) @db.Uuid
  settingKey   String    @unique @map("setting_key") @db.VarChar(100)
  settingValue String?   @map("setting_value")
  updatedBy    String?   @map("updated_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // Relations
  updatedByUser User?    @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("site_settings")
}

// Third-party credentials (Stripe, Moov) set by a super admin. `secrets` holds
// AES-256-GCM encrypted values; see services/integrationSettingsService.js.
model IntegrationSetting {
  id          String                 @id @default(uuid()) @db.Uuid
  provider    IntegrationProvider
  environment IntegrationEnvironment
  config      Json                   @default("{}")
  secrets     Json                   @default("{}")
  isActive    Boolean                @default(false) @map("is_active")
  updatedById String?                @map("updated_by") @db.Uuid
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  updatedBy   User?                  @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([provider, environment], map: "uq_integration_settings_provider_env")
  @@map("integration_settings")
}
